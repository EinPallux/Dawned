[Unit]
Description=Dawned admin panel (editor and live ops)
Documentation=https://github.com/EinPallux/Dawned-Admin
After=network-online.target postgresql.service dawned-game.service
Wants=network-online.target

[Service]
Type=simple
User=dawned
Group=dawned
WorkingDirectory=/opt/dawned/admin
EnvironmentFile=/etc/dawned/admin.env
ExecStart=/usr/bin/node --enable-source-maps dist/server/index.js
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/dawned
# The publish pipeline bakes maps into the GAME checkout's assets_baked/map,
# next to the committed dev-2 fallback (DEPLOYMENT.md §6) — and ProtectSystem=
# strict makes everything outside ReadWritePaths read-only, so without this line
# the panel cannot publish a map AT ALL. This unit was written at P0, months
# before A2 gave the panel a map to publish, and nothing exercised the path in
# production until P12-H tried to deploy a world with it. The leading `-`
# tolerates the directory not existing yet on a fresh box.
ReadWritePaths=-/opt/dawned/game/assets_baked

# Bake/thumbnail work must never starve the game server's tick.
Nice=10
CPUWeight=40
MemoryHigh=400M
MemoryMax=600M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dawned-admin

[Install]
WantedBy=multi-user.target
