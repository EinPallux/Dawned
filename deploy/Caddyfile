# Dawned — Caddy configuration.
# DEPLOY.sh/UPDATE.sh substitute {{DOMAIN}} and install this at /etc/caddy/Caddyfile.
# Reference: docs/tech/DEPLOYMENT.md §2.

{{DOMAIN}} {
	encode zstd gzip

	# --- game server: REST API + WebSocket -----------------------------------
	# The game server sets `Cache-Control: no-store` on every response itself
	# (packages/server/src/http/routes.ts); `defer` keeps this from fighting it
	# if that ever regresses — an API answer served from cache is a bug that
	# looks like "the update did not deploy".
	handle /api/* {
		header defer Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8081
	}

	# WebSocket upgrade for the game protocol.
	handle /game {
		reverse_proxy 127.0.0.1:8081
	}

	# --- admin panel (Dawned-Admin, phase A0+) -------------------------------
	# Decision 2026-08-02: /admin path, IP allowlist off. To restrict later,
	# uncomment the matcher below and list your addresses.
	#
	# handle_path, not handle: the panel is built against stripped paths
	# (assets at /assets/*, API at /api/* — Dawned-Admin vite.config.ts).
	# With plain `handle` the service's SPA fallback answers the un-stripped
	# /admin/assets/*.js requests with index.html (text/html), the browser
	# refuses the module on MIME, and the panel renders a blank page.
	handle_path /admin* {
		# @blocked not remote_ip 203.0.113.4 198.51.100.0/24
		# respond @blocked "Not authorised" 403
		reverse_proxy 127.0.0.1:8082
	}

	# --- published map/content artifacts (immutable, versioned paths) --------
	handle_path /published/* {
		root * /var/lib/dawned/published
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# --- baked maps, served from where the publish pipeline writes them -------
	# The client fetches `/assets/map/<version>/{meta,zones,walkgrid,chunks…}`
	# (packages/client/src/world/map-source.ts) and `assets:sync` used to satisfy
	# that by COPYING assets_baked/map into the client bundle at BUILD time. On a
	# dev box that is invisible, because a rebuild follows every publish anyway.
	# On the VPS it meant a published world never reached a player: the server
	# hot-loaded the new bake and reported it on /api/health, the client asked for
	# its artifacts, and every one of them 404'd against a bundle built before the
	# publish. A2's whole "the game hot-loads a new map without a deploy" claim was
	# true server-side and false in the browser — found by the first world deploy
	# (P12-H), which put the Dawnlands on the box and left the client with
	# "map failed to load — refresh".
	#
	# Serving the bake directory itself removes the copy, the 23 MB-per-version
	# duplication into dist, and the rebuild. Declared BEFORE the client handler
	# because Caddy takes the first matching `handle`. Versioned paths, so the
	# blanket /assets/* immutable header below is correct for these too.
	handle_path /assets/map/* {
		root * /opt/dawned/game/assets_baked/map
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# --- game client (static bundle) -----------------------------------------
	handle {
		root * /opt/dawned/game/packages/client/dist

		# Content-hashed assets and versioned map directories can be cached forever.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# ...EXCEPT the manifest: stable name, new hashes inside after every bake.
		# An immutable-cached manifest resolves assets that no longer exist —
		# declared after the blanket rule so this later directive wins for it.
		@manifest path /assets/manifest.json
		header @manifest Cache-Control "no-cache"

		# Everything that is NOT a content-hashed asset is (or falls back to)
		# index.html, and index.html must never be cached or players keep
		# yesterday's bundle after a deploy — the "works in a private window"
		# bug. Matching by negation covers deep links too: `try_files` rewrites
		# /anything to /index.html AFTER the header directives have run, so a
		# rule that matched only `/` and `/index.html` left every other route
		# with no cache header at all, and browsers are free to invent a
		# freshness lifetime when there is none.
		@notasset not path /assets/*
		header @notasset Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	header {
		# The client is self-contained: no third-party scripts, fonts or images.
		# connect-src needs blob:! three.js loads GLB-embedded textures by
		# fetch()ing blob: URLs, and fetch answers to connect-src (not img-src) —
		# without it every texture is silently blocked and the world renders
		# untextured white (found in the first production playtest).
		# font-src is declared (not left to default-src) because the admin panel
		# serves its own font files; both apps ship fonts as same-origin files,
		# never data: URIs (the admin build disables asset inlining for this).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws: wss: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /var/log/caddy/dawned.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# --- Optional subdomain variant for the admin panel ---------------------------
# Needs a DNS A record for admin.{{DOMAIN}} pointing at this box.
#
# admin.{{DOMAIN}} {
# 	reverse_proxy 127.0.0.1:8082
# }
