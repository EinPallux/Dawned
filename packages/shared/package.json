{
  "name": "@dawned/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared contract between the Dawned client and server: protocol, formulas, constants, math.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepare": "tsc -b tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "clean": "rm -rf dist dist-types *.tsbuildinfo"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "@types/pg": "8.20.3",
    "drizzle-kit": "0.31.10",
    "pg": "8.22.0",
    "typescript": "5.9.3"
  }
}
