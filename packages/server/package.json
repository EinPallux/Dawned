{
  "name": "@dawned/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dawned game server — authoritative simulation, REST + WebSocket gateway.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
