    {
      "pack": "kaykit-forest",
      "category": "world/nature",
      "glob": "Assets/gltf/Tree_*.gltf",
      "limit": 4
    },
    {
      "pack": "kaykit-forest",
      "category": "world/nature",
      "glob": "Assets/gltf/Rock_*.gltf",
      "limit": 3
    },
    {
      "$comment": "P2 foliage set \u2014 instanced per terrain chunk (grass tufts, bushes, bare trees for the ashen zone).",
