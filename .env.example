# Dawned game server — copy to packages/server/.env for local dev.
# On the VPS this lives at /etc/dawned/game.env (see docs/tech/DEPLOYMENT.md).

NODE_ENV=development
PORT=8081
HOST=127.0.0.1

# Postgres. Local dev defaults to this value when unset; production refuses to
# start on the dev default (set the real credentials in /etc/dawned/game.env).
DATABASE_URL=postgres://dawned:dawned@127.0.0.1:5432/dawned

# Registration gate (Q8: open registration; set a code to require an invite).
# INVITE_CODE=

# Secrets — generate with: openssl rand -hex 32
SESSION_PEPPER=dev-only-pepper-change-me
OPS_SECRET=dev-only-ops-secret-change-me

# Published content/map artifacts (P12+); local dev uses a repo-relative dir
PUBLISHED_DIR=./.published

# Client dev server origin allowed to connect (CORS/WS origin check)
CLIENT_ORIGIN=http://localhost:5173

# Hard cap on simultaneous players (the community is 5-20; headroom for bots/tests)
MAX_PLAYERS=50

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
